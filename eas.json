{
  "cli": {
    "version": ">= 15.0.14",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "GOOGLE_SERVICES_JSON_FILE": "GOOGLE_SERVICES_JSON_FILE"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "GOOGLE_SERVICES_JSON_FILE": "GOOGLE_SERVICES_JSON_FILE"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
